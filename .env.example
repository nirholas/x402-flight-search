# ——— Where the money goes ———
# Both rails ship pre-filled with the x402 Suite's public receive addresses, so
# the demo runs with zero setup. Change them to your own to get paid.

# EVM (Base / Base Sepolia) USDC receive address.
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402

# Solana USDC receive address.
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ——— Payment networks (defaults are testnet-friendly) ———

# EVM network: base-sepolia (testnet, default) or base (mainnet).
#NETWORK=base-sepolia

# Solana network: mainnet-beta (default) or devnet.
#SOLANA_NETWORK=mainnet-beta

# Facilitators verify + settle payments, and they are rail-specific.
#
# EVM rail. Default https://x402.org/facilitator, which settles base-sepolia
# only. For Base mainnet point this at a mainnet-capable facilitator, e.g.
# Coinbase's CDP facilitator.
#FACILITATOR_URL=https://x402.org/facilitator

# Solana rail. Defaults to PayAI, which settles Solana — x402.org does not.
#SOLANA_FACILITATOR_URL=https://facilitator.payai.network

# Optional: Solana facilitator sponsor account that pays the SOL network fee on
# the buyer's behalf. Advertised as `extra.feePayer` in the 402 challenge.
#SOLANA_FEE_PAYER=

# ——— Upstream flight data (optional — fixtures are used without it) ———

# Amadeus Self-Service credentials. Free sandbox keys, no card required:
#   https://developers.amadeus.com  →  create an app  →  copy key + secret
# With both set, /search, /price and /check hit the real Amadeus API and
# responses are labelled source:"amadeus". Without them the server serves
# deterministic fixtures labelled source:"fixture" — the demo always works.
#AMADEUS_CLIENT_ID=
#AMADEUS_CLIENT_SECRET=

# Amadeus host. The default is the free test environment; switch to
# https://api.amadeus.com once you have production credentials.
#AMADEUS_HOST=https://test.api.amadeus.com

# ——— Tuning ———

# HTTP port (default 4022).
#PORT=4022

# Public base URL, used to build the absolute `resource` URL in 402 challenges.
# Set this when running behind a proxy or on a custom domain.
#PUBLIC_BASE_URL=https://flights.example.com
